# Copy this file to .env and fill in real values. Never commit .env.

# UCM CDR/REC API (Value-added Features -> API Configuration on the UCM).
# Use the UCM's LAN address; this gateway is meant to sit on the same network.
UCM_HOST=10.0.0.10
UCM_PORT=8443
UCM_USER=your_api_username
UCM_PASS=your_api_password
# Grandstream UCMs ship a self-signed certificate. Set true only if you have
# installed one your gateway host actually trusts.
UCM_VERIFY_SSL=false

# Which extensions this gateway may serve, comma separated.
# Empty means none: the allowlist fails closed on purpose.
ALLOWED_EXTENSIONS=

# How far back /calls looks when no start date is given
LOOKBACK_DAYS=30

# Gateway bind address and port
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=1587

# Credentials for calling THIS gateway (not the UCM).
# Sent as: Authorization: Bearer <secret>
# Format: name:secret,name2:secret2 -- generate a long random secret per partner.
GATEWAY_API_KEYS=partner1:CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Requests per minute per API key, and per IP for the public download route
REQUESTS_PER_MINUTE=30

# The externally reachable base URL for THIS gateway -- whatever your callers
# actually hit. Must match your port forward or reverse proxy.
PUBLIC_BASE_URL=https://pbx-gateway.example.com

# Signs recording_url links so they work with no auth header. Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Keep it secret; changing it invalidates every previously issued link.
DOWNLOAD_SIGNING_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# The UCM's clock timezone, used to attach +HH:MM to started_at/updated_at
UCM_TIMEZONE_OFFSET=+00:00

# Shown in GET /health as "name"
GATEWAY_NAME=Customer PBX
